{
  "name": "telegram-cloud-drive",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "npx esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/worker.js --platform=browser --external:cloudflare:workers",
    "typecheck": "npx tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev"
  },
  "dependencies": {
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250417.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "wrangler": "^3.114.0"
  }
}
