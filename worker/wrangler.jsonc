{
  "name": "tgdrive",
  "main": "dist/worker.js",
  "compatibility_date": "2025-07-01",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "kv_namespaces": [
    { "binding": "METADATA_KV", "id": "e93083a3832c412fab0ba9a371fb0aa5" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "tgdrive-db", "database_id": "50be523a-7cef-41fb-b30c-2f5758b5be39" }
  ]
}
