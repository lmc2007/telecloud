# Cloudflare API Token（必需）
# 从 https://dash.cloudflare.com/profile/api-tokens 创建
CLOUDFLARE_API_TOKEN=your-api-token-here

# Worker 项目名称（可选，默认 tgdrive）
WORKER_NAME=tgdrive

# Pages 项目名称（可选，默认 tgdrive-pages）
PAGES_NAME=tgdrive-pages

# 自定义域名（可选，留空则使用 *.workers.dev 默认域名）
# 例如: pan.example.com
DOMAIN=
